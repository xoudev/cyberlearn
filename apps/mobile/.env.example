# Public Supabase config for the mobile app (safe to expose - RLS protects data).
# Copy to .env.local and fill from the same project the web app uses.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Web app base URL for the mobile API routes (default: https://cyberlearn.fr).
# Point it at http://<your-LAN-ip>:3000 to test against a local dev server.
EXPO_PUBLIC_SITE_URL=
