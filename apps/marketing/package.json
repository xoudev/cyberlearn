{
  "name": "@cyberlearn/marketing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "audio:generate": "node scripts/generate-soundtrack.mjs",
    "studio": "remotion studio src/index.tsx",
    "render:icon": "remotion still src/index.tsx StoreIcon dist/app-icon.png",
    "render:feature": "remotion still src/index.tsx FeatureGraphic dist/feature-graphic.png",
    "render:youtube-banner": "remotion still src/index.tsx YouTubeBanner dist/youtube-banner.png",
    "render:youtube-thumbnail": "remotion still src/index.tsx YouTubeThumbnail dist/youtube-thumbnail.png",
    "render:home": "remotion still src/index.tsx StoreHome dist/phone-01-home.png",
    "render:paths": "remotion still src/index.tsx StorePaths dist/phone-02-paths.png",
    "render:lesson": "remotion still src/index.tsx StoreLesson dist/phone-03-lesson.png",
    "render:profile": "remotion still src/index.tsx StoreProfile dist/phone-04-profile.png",
    "render:locker": "remotion still src/index.tsx StoreLocker dist/phone-05-locker.png",
    "render:video": "remotion render src/index.tsx PromoVideo dist/cyberlearn-promo.mp4 --codec=h264 --crf=18",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cyberlearn/tokens": "workspace:*",
    "react": "catalog:",
    "remotion": "catalog:"
  },
  "devDependencies": {
    "@remotion/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:"
  }
}
