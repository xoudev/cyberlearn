{
  "name": "cyberlearn",
  "private": true,
  "version": "0.0.1",
  "description": "CyberLearn - Interactive learning platform for dev, cybersecurity, and network/systems",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "biome format --write .",
    "format:check": "biome check --formatter-enabled=true .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky",
    "reset:users": "node scripts/reset-users.mjs"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "subject-case": [
        2,
        "never",
        [
          "start-case",
          "pascal-case",
          "upper-case"
        ]
      ],
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "test",
          "chore",
          "perf",
          "ci",
          "revert",
          "security"
        ]
      ]
    }
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "next": "catalog:",
    "turbo": "^2.11.4"
  },
  "pnpm": {
    "overrides": {
      "dompurify@<3.4.13": "^3.4.16",
      "lodash-es@<4.18.1": "^4.18.1",
      "mysql2@<3.24.4": "^3.24.4",
      "deepmerge-ts@<8": "^8.0.2",
      "@babel/core@<7.29.6": "^7.29.6",
      "sharp@<0.35.5": "^0.35.5",
      "compression@<1.8.2": "^1.8.2",
      "source-map-js@<1.2.2": "^1.2.2",
      "shell-quote@<1.11.0": "^1.11.0",
      "@humanfs/node@<0.16.8": "^0.16.8",
      "postcss-selector-parser@>=7.0.0 <7.1.6": "^7.1.6"
    }
  }
}
