{
  "name": "@cyberlearn/lib",
  "version": "0.0.1",
  "private": true,
  "description": "Shared business logic utilities (XP/levels, SM-2, auth guards, etc.)",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./xp": "./src/xp.ts",
    "./sm2": "./src/sm2.ts",
    "./pseudonymize": "./src/pseudonymize.ts",
    "./gamification/*": "./src/gamification/*.ts",
    "./search/*": "./src/search/*.ts",
    "./mdx-check": "./src/mdx/check.ts",
    "./mdx-quizzes": "./src/mdx/quizzes.ts",
    "./paths/*": "./src/paths/*.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cyberlearn/types": "workspace:*",
    "@mdx-js/mdx": "catalog:",
    "remark-gfm": "catalog:"
  },
  "peerDependencies": {
    "next": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@cyberlearn/config": "workspace:*",
    "next": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript-eslint": "catalog:",
    "react": "catalog:",
    "@types/react": "catalog:"
  }
}
