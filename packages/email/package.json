{
  "name": "@cyberlearn/email",
  "version": "0.0.1",
  "private": true,
  "description": "React Email templates for transactional emails (Resend)",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "email:dev": "email dev --dir src/templates",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@react-email/components": "catalog:",
    "resend": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@cyberlearn/config": "workspace:*",
    "react": "catalog:",
    "typescript": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
