# Compiled output — packages/db is consumed via TypeScript path alias
# "@cyberlearn/db": ["./src/index.ts"], so .js/.d.ts/maps are never
# needed. tsc emits them inline because library.json has no outDir.
src/**/*.js
src/**/*.js.map
src/**/*.d.ts
src/**/*.d.ts.map
# prisma/ scripts (seed.ts, reset-user.ts) also compile inline
prisma/**/*.js
prisma/**/*.js.map
prisma/**/*.d.ts
prisma/**/*.d.ts.map
