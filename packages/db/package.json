{
  "name": "@cyberlearn/db",
  "version": "0.0.1",
  "private": true,
  "description": "Prisma client, schema, migrations, and database utilities",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./supabase/server": "./src/supabase/server.ts",
    "./supabase/client": "./src/supabase/client.ts",
    "./supabase/admin": "./src/supabase/admin.ts",
    "./prisma": "./src/prisma.ts",
    "./catalogue": "./src/catalogue/index.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "build": "prisma generate && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:integration": "vitest run integration",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:reset-user": "tsx --env-file-if-exists=.env prisma/reset-user.ts",
    "db:reset-users": "tsx --env-file-if-exists=.env prisma/reset-users.ts",
    "db:reset-content": "tsx --env-file-if-exists=.env prisma/reset-content.ts",
    "db:seed-paths": "tsx --env-file-if-exists=.env prisma/seed-paths.ts",
    "db:seed-quizzes": "tsx --env-file-if-exists=.env prisma/seed-quizzes.ts",
    "db:seed-cosmetics": "tsx --env-file-if-exists=.env prisma/seed-cosmetics.ts",
    "db:seed-season": "tsx --env-file-if-exists=.env prisma/seed-season.ts",
    "db:backfill-badge-xp": "tsx --env-file-if-exists=.env prisma/backfill-badge-xp.ts",
    "db:backfill-daily-streaks": "tsx --env-file-if-exists=.env prisma/backfill-daily-streaks.ts",
    "db:studio": "prisma studio",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@cyberlearn/lib": "workspace:*",
    "@cyberlearn/types": "workspace:*",
    "@prisma/adapter-pg": "catalog:",
    "@prisma/client": "catalog:",
    "@supabase/ssr": "catalog:",
    "@supabase/supabase-js": "catalog:"
  },
  "devDependencies": {
    "@cyberlearn/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "prisma": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
