// packages/db/prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// USERS & AUTH
// ============================================================

enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

// Controls how a user appears on the public leaderboard.
// Anonymization is enforced server-side in leaderboardRepository - never client-side.
enum LeaderboardVisibility {
  HIDDEN // Excluded from the leaderboard entirely (not listed, not ranked)
  ANONYMOUS // Ranked and counted, shown as "Anonyme" - no name, username, or avatar
  PUBLIC // Full identity (name, username, avatar) visible to everyone
}

model User {
  id            String   @id @db.Uuid // Direct link with Supabase auth.users
  email         String   @unique
  username      String?  @unique @db.VarChar(32) // Null until onboarding is complete
  displayName   String   @db.VarChar(64)
  avatarUrl     String?
  bio           String?  @db.VarChar(280)
  role          UserRole @default(STUDENT)
  xpTotal       Int      @default(0)
  level         Int      @default(1)
  streakDays    Int      @default(0)
  longestStreak Int      @default(0) // Record streak (all-time best)
  streakFreezes Int      @default(1) // Freeze tokens in reserve (auto-cover one missed day)
  lastActiveAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  preferences       UserPreferences?
  lessonProgress    UserLessonProgress[]
  pathProgress      UserPathProgress[]
  badges            UserBadge[]
  certificates      Certificate[]
  notifications     Notification[]
  reviewSchedules   ReviewSchedule[]
  contactTickets    ContactTicket[]
  ratings           Rating[]
  questions         LessonQuestion[]
  answers           LessonAnswer[]
  auditLogs         AuditLog[]              @relation("ActorLogs")
  placementResult   UserPlacementResult?
  skipWaivers       UserSkipWaiver[]
  challengeProgress UserChallengeProgress[]
  hintReveals       ChallengeHintReveal[]
  deletionTokens    AccountDeletionToken[]
  quizAttempts      QuizAttempt[]
  activityDays      UserActivityDay[]
  questProgress     UserQuestProgress[]
  cosmetics         UserCosmetic[]
  cosmeticLoadout   UserCosmeticLoadout?
  leagueMemberships LeagueMembership[]
  xpLedger          XpLedger[]
  wrappedSnapshots  WrappedSnapshot[]
  answerUpvotes     LessonAnswerUpvote[]
  notes             Note[]
  noteFolders       NoteFolder[]
  classMemberships  ClassMember[]
  taughtClasses     ClassTeacher[]          @relation("ClassTeacher")

  @@index([username])
  @@index([role])
  @@map("users")
}

/// A school, a campus, a training centre - whatever owns the promotions.
model Establishment {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @db.VarChar(160)
  slug       String    @unique
  city       String?   @db.VarChar(120)
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  promotions Promotion[]

  @@map("establishments")
}

/// An intake within an establishment - "2025-2026", "BTS SIO 1re annee".
///
/// A class reaches its establishment through its promotion and only through it.
/// Hanging an establishmentId on Class as well would create a second path to
/// the same answer, and two paths can disagree: a class filed under campus A
/// inside a promotion belonging to campus B. One chain, no contradiction
/// possible.
model Promotion {
  id              String    @id @default(uuid()) @db.Uuid
  establishmentId String    @db.Uuid
  name            String    @db.VarChar(160)
  slug            String
  /// Academic year the intake starts, for sorting current promotions first.
  startYear       Int?
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  classes       Class[]

  /// Scoped, not global: two establishments may each run a "2025-2026".
  @@unique([establishmentId, slug])
  @@index([establishmentId, startYear])
  @@map("promotions")
}

/// A group of students an admin creates and a teacher follows.
///
/// Membership is the fact, not the role: a learner with no class is simply a
/// STUDENT whose membership list is empty. Keeping "is in a class" out of
/// UserRole means there is no second copy of that state to drift - leaving a
/// class cannot leave a stale role behind.
model Class {
  id          String    @id @default(uuid()) @db.Uuid
  promotionId String    @db.Uuid
  name        String    @db.VarChar(120)
  slug        String
  description String?   @db.VarChar(500)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  promotion Promotion      @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  teachers  ClassTeacher[]
  members   ClassMember[]

  /// Scoped to the promotion: "SIO1-A" exists in more than one school.
  @@unique([promotionId, slug])
  @@map("classes")
}

/// A teacher assigned to a class.
///
/// A class carries several, because in a real school it does - one per subject
/// more often than not. A single teacherId column could only ever hold the
/// first one, and the second would have had nowhere to go.
model ClassTeacher {
  classId    String   @db.Uuid
  teacherId  String   @db.Uuid
  /// What they teach this class. Optional, and the reason several teachers
  /// share a class in the first place, so a roster reads as names with subjects
  /// rather than an undifferentiated list.
  subject    String?  @db.VarChar(120)
  assignedAt DateTime @default(now())

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher User  @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@id([classId, teacherId])
  @@index([teacherId])
  @@map("class_teachers")
}

model ClassMember {
  classId  String   @db.Uuid
  userId   String   @db.Uuid
  joinedAt DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
  @@index([userId])
  @@map("class_members")
}

model UserPreferences {
  userId             String  @id @db.Uuid
  theme              String  @default("dark") // "dark" | "light" | "system"
  locale             String  @default("fr")
  emailNotifications Boolean @default(true)
  reviewReminders    Boolean @default(true)
  weeklyDigest       Boolean @default(true)
  streakReminder     Boolean @default(true) // Email before a daily streak is lost (toggle UI pending)
  publicProfile      Boolean @default(true) // Controls First Blood & public profile visibility

  // Defaults to ANONYMOUS (privacy-first). Absence of a row is also treated as
  // ANONYMOUS by the leaderboard repository (pre-onboarding users have no row).
  leaderboardVisibility LeaderboardVisibility @default(ANONYMOUS)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ============================================================
// PLACEMENT TEST
// ============================================================

model PlacementQuestion {
  id              String     @id @default(uuid()) @db.Uuid
  category        Category
  difficulty      Difficulty
  question        String     @db.Text
  options         Json // Array: [{ id: "a", text: "..." }, ...] - safe to expose to client
  correctOptionId String     @db.VarChar(10) // NEVER sent to client - validated server-side only
  explanation     String?    @db.Text // Shown after test completion
  orderIndex      Int
  isActive        Boolean    @default(true)

  @@index([category, difficulty, isActive])
  @@map("placement_questions")
}

model UserPlacementResult {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @db.Uuid
  devScore      Int // 0-100
  cybersecScore Int // 0-100
  networkScore  Int // 0-100
  completedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_placement_results")
}

// Tracks which lesson prerequisites are waived for a user (from placement test results).
// A waiver lets users access advanced lessons without completing beginner/intermediate ones,
// but does NOT award XP or mark lessons as COMPLETED.
model UserSkipWaiver {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  lessonId    String   @db.Uuid
  grantedAt   DateTime @default(now())
  grantReason String   @default("placement_test")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("user_skip_waivers")
}

// ============================================================
// LESSONS & CONTENT
// ============================================================

enum Category {
  DEV
  CYBERSEC
  NETWORK
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Lesson {
  id               String        @id @default(uuid()) @db.Uuid
  refCode          String        @unique // Format: CL-LSN-001-V01
  slug             String        @unique
  title            String        @db.VarChar(200)
  description      String        @db.VarChar(500)
  category         Category
  difficulty       Difficulty
  estimatedMinutes Int
  xpReward         Int
  contentMdx       String        @db.Text
  coverImageUrl    String?
  status           ContentStatus @default(DRAFT)
  version          Int           @default(1)
  authorId         String        @db.Uuid
  avgRating        Float? // Recomputed in transaction on each Rating mutation
  ratingsCount     Int           @default(0)
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  pathLessons     PathLesson[]
  progress        UserLessonProgress[]
  reviewSchedules ReviewSchedule[]
  ratings         Rating[]
  questions       LessonQuestion[]
  prerequisites   LessonPrerequisite[] @relation("LessonPrerequisites")
  prerequisiteOf  LessonPrerequisite[] @relation("PrerequisiteOf")
  skipWaivers     UserSkipWaiver[]
  notes           Note[]

  @@index([category, difficulty, status])
  @@index([slug])
  @@map("lessons")
}

// One markdown note per (user, lesson): written from the in-lesson note drawer
// and listed in the notes library. A user fully owns their notes (RLS: own rows
// only). content is markdown; wordCount is denormalized for the library cards.
// folderId is the user's optional custom organization (SetNull: deleting a
// folder ungroups its notes rather than deleting them).
model Note {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  lessonId  String   @db.Uuid
  folderId  String?  @db.Uuid
  content   String   @default("") @db.Text
  wordCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  folder NoteFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([folderId])
  @@map("notes")
}

// A user-owned folder for organizing notes. A note points at most to one folder
// (single-membership, "dossier" model). A user fully owns their folders
// (RLS: own rows only). position drives manual ordering; color and icon are
// optional and picked from fixed client palettes (icon defaults to "folder").
model NoteFolder {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  name      String   @db.Text
  color     String?  @db.Text
  icon      String?  @db.Text
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes Note[]

  @@index([userId])
  @@map("note_folders")
}

model LessonPrerequisite {
  lessonId       String @db.Uuid
  prerequisiteId String @db.Uuid

  lesson       Lesson @relation("LessonPrerequisites", fields: [lessonId], references: [id], onDelete: Cascade)
  prerequisite Lesson @relation("PrerequisiteOf", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([lessonId, prerequisiteId])
  @@map("lesson_prerequisites")
}

// ============================================================
// PATHS (PARCOURS)
// ============================================================

// What a path is meant to be, orthogonal to Category (which says *what domain*
// it covers). SKILL is a single competence - a language, a tool, a body of
// theory. CAREER is a job: the description usually says so outright ("le métier
// de testeur d'intrusion"). A learner browses the two differently, so they are
// filtered apart rather than mixed into one list.
enum PathTrack {
  SKILL
  CAREER
}

model Path {
  id                  String        @id @default(uuid()) @db.Uuid
  refCode             String        @unique // Format: CL-PATH-001-V01
  slug                String        @unique
  title               String        @db.VarChar(200)
  description         String        @db.VarChar(1000)
  category            Category
  track               PathTrack     @default(SKILL)
  difficulty          Difficulty
  estimatedHours      Int
  coverImageUrl       String?
  certificateTemplate String? // Reference to PDF template
  certificateBadgeId  String?       @db.Uuid
  status              ContentStatus @default(DRAFT)
  version             Int           @default(1)
  avgRating           Float? // Recomputed in transaction on each Rating mutation
  ratingsCount        Int           @default(0)
  publishedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  lessons      PathLesson[]
  progress     UserPathProgress[]
  certificates Certificate[]
  ratings      Rating[]
  quiz         Quiz?

  @@index([category, status])
  @@index([track, status])
  @@map("paths")
}

model PathLesson {
  pathId     String  @db.Uuid
  lessonId   String  @db.Uuid
  position   Int
  isRequired Boolean @default(true)

  path   Path   @relation(fields: [pathId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([pathId, lessonId])
  @@unique([pathId, position])
  @@map("path_lessons")
}

// ============================================================
// CHALLENGES
// ============================================================

enum ChallengeType {
  CTF
  PUZZLE
  LAB
  SCRIPT
}

model Challenge {
  id             String        @id @default(uuid()) @db.Uuid
  refCode        String        @unique // Format: CL-CHG-001
  slug           String        @unique
  title          String        @db.VarChar(200)
  description    String        @db.VarChar(1000)
  instructions   String        @db.Text // MDX - what the user must do
  category       Category
  difficulty     Difficulty
  type           ChallengeType
  xpReward       Int
  timeLimitMin   Int           @default(0) // 0 = no time limit
  maxAttempts    Int           @default(3)
  flag           String? // CTF/SCRIPT - expected answer (plaintext, admin-only readable)
  starterCode    String? // SCRIPT only - pre-populated Python code in the runner
  attachmentUrl  String? // URL to downloadable challenge file (binary, pcap, zip…)
  resourceUrl    String? // Target URL or connection info (e.g. nc host 1337)
  isActive       Boolean       @default(true)
  orderIndex     Int           @default(0)
  prerequisiteId String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  prerequisite Challenge?              @relation("ChallengeDeps", fields: [prerequisiteId], references: [id])
  dependents   Challenge[]             @relation("ChallengeDeps")
  progress     UserChallengeProgress[]
  hints        ChallengeHint[]

  @@index([category, difficulty, isActive])
  @@map("challenges")
}

model UserChallengeProgress {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  challengeId String         @db.Uuid
  status      ProgressStatus @default(IN_PROGRESS)
  attempts    Int            @default(0)
  startedAt   DateTime       @default(now())
  completedAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId])
  @@map("user_challenge_progress")
}

model ChallengeHint {
  id          String @id @default(uuid()) @db.Uuid
  challengeId String @db.Uuid
  orderIndex  Int    @default(0)
  content     String @db.Text
  xpCost      Int    @default(0) // XP penalty to reveal; 0 = free

  challenge Challenge             @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  reveals   ChallengeHintReveal[]

  @@index([challengeId, orderIndex])
  @@map("challenge_hints")
}

model ChallengeHintReveal {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  hintId     String   @db.Uuid
  revealedAt DateTime @default(now())

  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  hint ChallengeHint @relation(fields: [hintId], references: [id], onDelete: Cascade)

  @@unique([userId, hintId])
  @@index([userId])
  @@map("challenge_hint_reveals")
}

// ============================================================
// GAMIFICATION
// ============================================================

enum BadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum BadgeCriterionType {
  LESSON_COMPLETED
  PATH_COMPLETED
  XP_THRESHOLD
  STREAK_DAYS
  CATEGORY_MASTERY
  PERFECT_QUIZ
  CUSTOM
  LESSON_SPECIFIC
  LEVEL
  BADGE_EARNED
}

model Badge {
  id            String             @id @default(uuid()) @db.Uuid
  refCode       String             @unique // Format: CL-BDG-001
  name          String             @unique @db.VarChar(100)
  description   String             @db.VarChar(500)
  iconUrl       String
  rarity        BadgeRarity
  criterionType BadgeCriterionType
  criterionData Json // { lessonId: "...", count: 5, etc. }
  xpReward      Int                @default(0)
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  badgeId  String   @db.Uuid
  earnedAt DateTime @default(now())
  context  Json? // Acquisition context (lessonId, pathId...)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

// ============================================================
// COSMETICS (unlockable, equip-per-slot, merit-only)
// ============================================================

enum CosmeticType {
  TERMINAL_THEME
  HEXAGON_STYLE
  PROFILE_FRAME
  ACCENT_COLOR
}

model Cosmetic {
  id            String             @id @default(uuid()) @db.Uuid
  code          String             @unique @db.VarChar(40) // stable key; drives the CSS in the design system
  type          CosmeticType
  label         String             @db.VarChar(80)
  description   String?            @db.VarChar(280)
  rarity        BadgeRarity        @default(COMMON)
  criterionType BadgeCriterionType
  criterionData Json
  orderIndex    Int                @default(0)
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())

  unlocks UserCosmetic[]

  @@index([type, isActive])
  @@map("cosmetics")
}

model UserCosmetic {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  cosmeticId String   @db.Uuid
  unlockedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic Cosmetic @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@unique([userId, cosmeticId])
  @@index([userId])
  @@map("user_cosmetics")
}

// One row per user: the equipped Cosmetic.code per slot (null = platform default).
model UserCosmeticLoadout {
  userId        String   @id @db.Uuid
  terminalTheme String?  @db.VarChar(40)
  hexagonStyle  String?  @db.VarChar(40)
  profileFrame  String?  @db.VarChar(40)
  accentColor   String?  @db.VarChar(40)
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_cosmetic_loadouts")
}

// ============================================================
// LEAGUES (seasonal, competitive; distinct from the permanent palier)
// ============================================================

enum SeasonStatus {
  ACTIVE
  CLOSING
  CLOSED
}

enum LeagueDivision {
  BRONZE
  ARGENT
  OR
  PLATINE
  DIAMANT
}

model Season {
  id        String       @id @default(uuid()) @db.Uuid
  index     Int          @unique // 1, 2, 3, ... sequential
  startsAt  DateTime
  endsAt    DateTime
  status    SeasonStatus @default(ACTIVE)
  createdAt DateTime     @default(now())

  memberships LeagueMembership[]

  @@index([status])
  @@map("seasons")
}

// A user's standing in one season: division + pod, and the seasonXp earned THIS
// season (distinct from User.xpTotal). division/pod/seasonXp/rank are written
// server-side only (creditXp + the rollover); never by clients.
model LeagueMembership {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @db.Uuid
  seasonId   String         @db.Uuid
  division   LeagueDivision @default(BRONZE)
  pod        Int            @default(1)
  seasonXp   Int            @default(0)
  finalRank  Int? // rank within the pod (1..15), set at rollover
  globalRank Int? // rank across the whole season by seasonXp, set at rollover
  promoted   Boolean        @default(false)
  relegated  Boolean        @default(false)
  joinedAt   DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([userId, seasonId])
  @@index([seasonId, division, pod, seasonXp])
  @@map("league_memberships")
}

// ============================================================
// RATINGS & Q&A
// ============================================================

// Rating only allowed when UserLessonProgress/UserPathProgress status = COMPLETED
model Rating {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid // null after RGPD anonymization
  lessonId  String?  @db.Uuid
  pathId    String?  @db.Uuid
  score     Int      @db.SmallInt // 1-5, validated by Zod in the service layer
  feedback  String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  path   Path?   @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@unique([userId, pathId])
  @@index([lessonId])
  @@index([pathId])
  @@map("ratings")
}

model LessonQuestion {
  id         String   @id @default(uuid()) @db.Uuid
  lessonId   String   @db.Uuid
  userId     String?  @db.Uuid // null after RGPD anonymization
  title      String   @db.VarChar(200)
  content    String   @db.Text
  isResolved Boolean  @default(false)
  isHidden   Boolean  @default(false) // Soft-delete for moderation
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lesson  Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers LessonAnswer[]

  @@index([lessonId, isHidden])
  @@index([userId])
  @@map("lesson_questions")
}

model LessonAnswer {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  userId     String?  @db.Uuid // null after RGPD anonymization
  content    String   @db.Text
  isAccepted Boolean  @default(false) // Marked by the question author
  isHidden   Boolean  @default(false)
  upvotes    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question      LessonQuestion       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  upvoteRecords LessonAnswerUpvote[]

  @@index([questionId, isHidden])
  @@map("lesson_answers")
}

// One row per (answer, user): a user can upvote a given answer at most once.
// LessonAnswer.upvotes stays as a denormalized count, kept in sync server-side.
model LessonAnswerUpvote {
  id        String   @id @default(uuid()) @db.Uuid
  answerId  String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  answer LessonAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([answerId, userId])
  @@index([answerId])
  @@map("lesson_answer_upvotes")
}

// ============================================================
// PROGRESS TRACKING
// ============================================================

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model UserLessonProgress {
  id               String         @id @default(uuid()) @db.Uuid
  userId           String         @db.Uuid
  lessonId         String         @db.Uuid
  status           ProgressStatus @default(IN_PROGRESS)
  attempts         Int            @default(0)
  bestScore        Int? // 0-100
  timeSpentSeconds Int            @default(0)
  startedAt        DateTime       @default(now())
  completedAt      DateTime?
  lastAccessedAt   DateTime       @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, status])
  @@map("user_lesson_progress")
}

// ============================================================
// WEEKLY QUESTS
// ============================================================

enum QuestType {
  LESSON_COMPLETED
  PERFECT_QUIZ
  STREAK_DAYS
  FORUM_POST
  WEEKLY_BONUS
}

// Catalog of weekly quests (fixed set; admin-managed seed data).
model Quest {
  id           String    @id @default(uuid()) @db.Uuid
  code         String    @unique
  title        String
  description  String    @db.Text
  type         QuestType
  target       Int
  xpReward     Int
  freezeReward Int       @default(0)
  orderIndex   Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  progress UserQuestProgress[]

  @@map("quests")
}

// Per-user weekly progress, scoped to an ISO week key ("YYYY-Www", Europe/Paris).
// A new week is simply a new key (lazy reset, no cron). Written server-side only.
model UserQuestProgress {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  questId     String    @db.Uuid
  weekKey     String    @db.VarChar(10)
  progress    Int       @default(0)
  completed   Boolean   @default(false)
  claimed     Boolean   @default(false)
  completedAt DateTime?
  claimedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId, weekKey])
  @@index([userId, weekKey])
  @@map("user_quest_progress")
}

// One row per calendar day (Europe/Paris) a user performed a qualifying
// activity. Source of truth for the activity heatmap; written server-side only.
model UserActivityDay {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  day       DateTime @db.Date
  count     Int      @default(1)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@map("user_activity_days")
}

model UserPathProgress {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  pathId        String         @db.Uuid
  status        ProgressStatus @default(IN_PROGRESS)
  startedAt     DateTime       @default(now())
  completedAt   DateTime?
  certificateId String?        @unique @db.Uuid

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  path        Path         @relation(fields: [pathId], references: [id], onDelete: Cascade)
  certificate Certificate? @relation(fields: [certificateId], references: [id])

  @@unique([userId, pathId])
  @@index([userId, status])
  @@map("user_path_progress")
}

// ============================================================
// CERTIFICATIONS
// ============================================================

model Certificate {
  id            String    @id @default(uuid()) @db.Uuid
  publicId      String    @unique @default(uuid()) @db.Uuid // For public URL /verify/{publicId}
  userId        String?   @db.Uuid // null after RGPD anonymization
  pathId        String    @db.Uuid
  holderName    String? // Snapshot at issuance; set to "Utilisateur supprimé" on RGPD deletion
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime?
  score         Int? // Final quiz score (%) at issuance; null for legacy / path-completion-only certs
  passThreshold Int? // Snapshot of the quiz pass threshold at issuance
  sha256Hash    String    @unique // Hash of content for tamper detection
  pdfStorageKey String // Path in Supabase Storage
  revokedAt     DateTime?
  revokedReason String?

  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  path         Path              @relation(fields: [pathId], references: [id], onDelete: Cascade)
  pathProgress UserPathProgress?

  // One cert per user per path. userId is nullable, so RGPD-anonymized rows
  // (userId = NULL) never conflict (NULLs are distinct in a Postgres unique index).
  @@unique([userId, pathId])
  @@index([publicId])
  @@index([userId])
  @@map("certificates")
}

// ============================================================
// QUIZZES (final path quiz → score → certificate gate)
// ============================================================

model Quiz {
  id              String   @id @default(uuid()) @db.Uuid
  pathId          String   @unique @db.Uuid
  passThreshold   Int      @default(70) // Percent required to pass
  questionsToDraw Int // Number of questions randomly drawn per attempt
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  path      Path           @relation(fields: [pathId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quiz")
}

model QuizQuestion {
  id              String  @id @default(uuid()) @db.Uuid
  quizId          String  @db.Uuid
  question        String  @db.Text
  options         Json // Array: [{ id: "a", text: "..." }, ...] - safe to expose to client
  correctOptionId String  @db.VarChar(10) // SERVER-ONLY - never sent to client; the whole table is RLS-denied
  explanation     String? @db.Text // Shown after submission
  orderIndex      Int
  isActive        Boolean @default(true)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, isActive])
  @@map("quiz_questions")
}

model QuizAttempt {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  quizId      String    @db.Uuid
  score       Int // Percent (0–100)
  passed      Boolean
  // User selection + correct/incorrect per question. MUST NOT include
  // correctOptionId (reading one's own attempt would leak the answer key).
  answers     Json
  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId, quizId])
  @@map("quiz_attempts")
}

// ============================================================
// NOTIFICATIONS & SPACED REPETITION
// ============================================================

enum NotificationType {
  REVIEW_REMINDER
  BADGE_EARNED
  LEVEL_UP
  PATH_COMPLETED
  CERTIFICATE_ISSUED
  ANNOUNCEMENT
  TICKET_UPDATE
}

model Notification {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  type         NotificationType
  title        String           @db.VarChar(200)
  body         String           @db.VarChar(1000)
  actionUrl    String?
  metadata     Json?
  scheduledFor DateTime         @default(now())
  sentAt       DateTime?
  readAt       DateTime?
  emailSent    Boolean          @default(false)
  createdAt    DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([scheduledFor, sentAt])
  @@map("notifications")
}

// SM-2 simplified: ease factor + interval + repetitions
model ReviewSchedule {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  lessonId       String   @db.Uuid
  easeFactor     Float    @default(2.5)
  intervalDays   Int      @default(1)
  repetitions    Int      @default(0)
  nextReviewAt   DateTime
  lastReviewedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([nextReviewAt])
  @@map("review_schedules")
}

// ============================================================
// CONTACT & TICKETS (Jira sync)
// ============================================================

enum TicketTheme {
  BUG
  QUESTION
  FEATURE_REQUEST
  SECURITY
  CONTENT_ERROR
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model ContactTicket {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String?      @db.Uuid // Nullable for guests
  email        String? // Nullable after RGPD anonymization
  subject      String       @db.VarChar(200)
  theme        TicketTheme
  message      String       @db.Text
  jiraIssueKey String?      @unique // e.g. "CYBL-123"
  jiraIssueUrl String?
  status       TicketStatus @default(OPEN)
  ipAddress    String? // SHA-256 hashed (GDPR)
  userAgent    String?      @db.VarChar(500)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@map("contact_tickets")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorId       String?  @db.Uuid // null after RGPD anonymization (FK preserved as UUID)
  actorHashedId String? // HMAC-SHA256 of actorId set during RGPD anonymization
  anonymized    Boolean  @default(false)
  action        String   @db.VarChar(100) // e.g. "lesson.create", "user.role.update"
  targetType    String   @db.VarChar(50)
  targetId      String?
  metadata      Json?
  ipAddress     String? // SHA-256 hashed (GDPR)
  userAgent     String?  @db.VarChar(500)
  createdAt     DateTime @default(now())

  actor User? @relation("ActorLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([actorHashedId])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ============================================================
// RGPD - ACCOUNT DELETION
// ============================================================

model AccountDeletionToken {
  id        String    @id @default(cuid())
  userId    String    @db.Uuid
  tokenHash String    @unique // SHA-256 of the plain token sent by email
  expiresAt DateTime
  usedAt    DateTime?
  ip        String? // HMAC-SHA256 pseudonymized
  userAgent String?   @db.VarChar(500)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("account_deletion_tokens")
}

// ============================================================
// XP LEDGER (append-only; powers period-bucketed XP / Wrapped)
// ============================================================

enum XpSource {
  LESSON
  BADGE
  QUEST
  CHALLENGE
  REVIEW
}

// One row per XP credit, written inside creditXp's transaction. Append-only and
// server-written; lets us bucket XP by period (month / season), which the
// running User.xpTotal alone cannot express.
model XpLedger {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  amount    Int
  source    XpSource
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("xp_ledger")
}

// ============================================================
// WRAPPED (curated, shareable monthly/season recap snapshots)
// ============================================================

enum WrappedPeriod {
  MONTH
  SEASON
}

// A frozen, curated recap for one user + period. `payload` holds ONLY the
// curated stats (no raw or private data), so it is safe to render and (later)
// share. Server-written; one row per user + period.
model WrappedSnapshot {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  period    WrappedPeriod @default(MONTH)
  periodKey String        @db.VarChar(16) // "2026-03" for a month
  payload   Json
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, periodKey])
  @@index([userId])
  @@map("wrapped_snapshots")
}
