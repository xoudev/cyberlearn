{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "enabled": false
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/build",
      "!**/coverage",
      "!**/.turbo",
      "!**/*.min.js",
      "!**/pnpm-lock.yaml",
      "!**/docs",
      "!**/apps/web/public/runtimes",
      "!**/.vercel",
      "!**/packages/**/*/src/**/*.js",
      "!**/packages/**/*/src/**/*.js.map",
      "!**/packages/**/*/src/**/*.d.ts",
      "!**/packages/**/*/src/**/*.d.ts.map",
      "!**/packages/db/prisma/**/*.js",
      "!**/packages/db/prisma/**/*.js.map",
      "!**/packages/db/prisma/**/*.d.ts",
      "!**/packages/db/prisma/**/*.d.ts.map"
    ]
  }
}
