# Dependencies
node_modules/
.pnpm-store/

# Build outputs
.next/
.turbo/
dist/
build/
out/

# packages/db is consumed as TS source via the @cyberlearn/db alias and must
# never emit JS (tsconfig has noEmit). Guard against stale .js/.d.ts/maps next to
# the sources re-appearing and shadowing the .ts (scoped to src/ + prisma/ so the
# legitimate eslint.config.js at the package root is preserved).
packages/db/src/**/*.js
packages/db/src/**/*.d.ts
packages/db/src/**/*.js.map
packages/db/src/**/*.d.ts.map
packages/db/prisma/**/*.js
packages/db/prisma/**/*.d.ts
packages/db/prisma/**/*.js.map
packages/db/prisma/**/*.d.ts.map

# Environment files: NEVER commit real env files
.env
.env.local
.env.*.local
.env.production
.env.staging

# Keep the example
!.env.example

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/
.nyc_output/
playwright-report/
test-results/

# Vercel
.vercel/

# Misc
*.tgz
.cache/

.claude/
.vercel
.env*.local

# NOTE: do NOT re-add a broad `/docs` ignore. It was introduced in 1f83cd3 to
# keep then-local hardening notes untracked, but it silently ignored every NEW
# file under docs/ (runbooks, design sources) while the already-tracked ones
# stayed tracked (a trap). Nothing under docs/ is generated output; if a
# generator ever lands, ignore its exact output subdirectory only.