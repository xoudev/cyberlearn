# =============================================================================
# CyberLearn — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real credentials.
# Each variable is validated at startup via @t3-oss/env-nextjs (Zod schemas).
# See apps/web/lib/env.ts and apps/admin/lib/env.ts for the full schema.
# =============================================================================


# ─── Database ─────────────────────────────────────────────────────────────────
# Supabase Postgres connection string via PgBouncer (pooled — used by Prisma at runtime)
# Find it in: Supabase dashboard → Settings → Database → Connection string → URI (Transaction mode)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection without PgBouncer (used by Prisma for migrations)
# Find it in: Supabase dashboard → Settings → Database → Connection string → URI (Direct)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres"


# ─── Supabase ─────────────────────────────────────────────────────────────────
# Public Supabase project URL (safe to expose in browser)
# Find it in: Supabase dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL="https://[REF].supabase.co"

# Public anon key — limited permissions enforced by RLS (safe to expose)
# Find it in: Supabase dashboard → Settings → API → Project API keys → anon/public
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Service role key — FULL DATABASE ACCESS, SERVER ONLY, NEVER expose to client
# Find it in: Supabase dashboard → Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=""


# ─── Site URLs ────────────────────────────────────────────────────────────────
# Public app URL (used for redirects, canonical URLs, certificate QR codes)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Admin app URL
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"


# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Resend API key for sending transactional emails
# Generate at: https://resend.com/api-keys
RESEND_API_KEY="re_xxx"

# From address — must be a verified domain in Resend
RESEND_FROM_EMAIL="noreply@cyberlearn.app"


# ─── Jira Integration ─────────────────────────────────────────────────────────
# Contact form submissions are synced to Jira as issues
#
# Base URL of your Atlassian instance
# Example: https://your-org.atlassian.net
JIRA_BASE_URL="https://xxx.atlassian.net"

# Email of the Atlassian account used for API authentication
JIRA_API_EMAIL="admin@cyberlearn.app"

# Jira API token (NOT your account password)
# Generate at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=""

# Jira project key where contact tickets will be created (e.g. CYBL)
JIRA_PROJECT_KEY="CYBL"


# ─── Rate Limiting (Upstash Redis) ────────────────────────────────────────────
# Upstash Redis for @upstash/ratelimit (serverless-compatible)
# Create a free database at: https://upstash.com
# Find credentials in: Upstash console → Your database → REST API
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


# ─── Captcha (Cloudflare Turnstile) ───────────────────────────────────────────
# Used on the contact form to block bots
# Create a free site at: https://dash.cloudflare.com → Turnstile
#
# Site key (public — used in the browser widget)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Secret key (private — used server-side to verify the challenge)
TURNSTILE_SECRET_KEY=""


# ─── Security ─────────────────────────────────────────────────────────────────
# Salt for HMAC-SHA256 pseudonymization of IPs and emails in rate limit keys and audit_logs
# (GDPR — raw IPs/emails never stored in Redis or logs)
# Generate: openssl rand -hex 32
IP_SALT=""

# Secret token included in cron job requests (validated in /api/cron/* handlers)
# Must match the value configured in Vercel Cron settings
# Generate: openssl rand -hex 32
CRON_SECRET=""


# ─── Monitoring (Sentry) ──────────────────────────────────────────────────────
# Sentry DSN for error tracking and performance monitoring (optional in dev)
# Create a free project at: https://sentry.io
# Find in: Sentry → Your project → Settings → Client Keys (DSN)
SENTRY_DSN=""

# Sentry auth token for source map uploads during build
# Generate at: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=""
